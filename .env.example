# Copy to .env and adjust values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL
POSTGRES_DB=firona
POSTGRES_USER=firona
POSTGRES_PASSWORD=firona
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery (broker DB 0) and Django cache (locks, budgets, heartbeat: DB 1)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
LOG_LEVEL=INFO

# v3 collectors (optional). Empty = skip Ads Library HTTP and keep demo scores.
META_ADS_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# v4 robustness (defaults shown)
COLLECT_HTTP_TIMEOUT=20
COLLECT_HTTP_ATTEMPTS=3
COLLECT_BUDGET_META_ADS=150
COLLECT_BUDGET_GOOGLE_TRENDS=20
COLLECT_SOFT_TIME_LIMIT=900
STATUS_STALE_HOURS=13

# Public HTTP (host → nginx container :80). 80 is often taken on WSL.
NGINX_HOST_PORT=8080
